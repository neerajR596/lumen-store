# ---- Server ----
PORT=5050
CLIENT_URL=http://localhost:5173

# ---- MongoDB Atlas ----
# Paste your Atlas connection string (Atlas → Connect → Drivers) and fill in your user, password and cluster.
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<your-cluster>.mongodb.net/lumen?retryWrites=true&w=majority

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string

# ---- Admin account created by `npm run seed` ----
ADMIN_EMAIL=admin@lumen.store
ADMIN_PASSWORD=admin12345

# ---- Razorpay (test mode keys from https://dashboard.razorpay.com -> Settings -> API Keys) ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
